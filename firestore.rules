rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function ich()   { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function aktiv() { return request.auth != null && ich().active == true; }
    function admin() { return aktiv() && ich().role == 'admin'; }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || aktiv());
      // Selbstregistrierung nur als gesperrtes Mitglied
      allow create: if request.auth.uid == uid
                    && request.resource.data.role == 'member'
                    && request.resource.data.active == false;
      allow update, delete: if admin();
    }

    match /reports/{id} {
      allow read: if aktiv();
      allow create: if aktiv() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if admin();
    }

    match /promotions/{id} {
      allow read: if aktiv();
      allow create: if admin();
    }
  }
}
